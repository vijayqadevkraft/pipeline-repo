pipeline {
    agent any

    parameters {
        string(name: 'APP_NAME', defaultValue: 'simple-index-html', description: 'Application name')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch')
    }

    environment {
        APP_DIR = "app"
        SCRIPT_DIR = "script"
        DEPLOY_SCRIPT = "deploy.sh"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                echo "🧹 Cleaning workspace..."
                deleteDir()
            }
        }

        stage('Checkout Pipeline Repo') {
            steps {
                echo "✅ Jenkinsfile loaded"
            }
        }

        stage('Clone Application Repo') {
            steps {
                dir("${APP_DIR}") {
                    git branch: "${params.BRANCH}", url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        stage('Clone Script Repo') {
            steps {
                dir("${SCRIPT_DIR}") {
                    git branch: "${params.BRANCH}", url: 'https://github.com/vijayqadevkraft/script-repo.git'
                }
            }
        }

        stage('Verify Structure') {
            steps {
                sh '''
                echo "📂 Workspace structure:"
                ls -R
                '''
            }
        }

        stage('Build') {
            steps {
                echo "⚙️ No build required (static + Node handled in deploy)"
            }
        }

        stage('Deploy') {
            steps {
                sh """
                echo "🚀 Starting deployment..."

                DEPLOY_PATH="${SCRIPT_DIR}/${params.APP_NAME}/${DEPLOY_SCRIPT}"

                echo "📍 Using script: $DEPLOY_PATH"

                if [ ! -f "$DEPLOY_PATH" ]; then
                    echo "❌ ERROR: deploy.sh not found!"
                    exit 1
                fi

                chmod +x "$DEPLOY_PATH"

                echo "▶️ Running deployment script..."
                "$DEPLOY_PATH"
                """
            }
        }

        stage('Post Deployment Check') {
            steps {
                sh '''
                echo "🌐 Checking services..."

                systemctl status nginx || true
                pm2 list || true
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 Deployment Successful"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📌 Pipeline finished"
        }
    }
}
