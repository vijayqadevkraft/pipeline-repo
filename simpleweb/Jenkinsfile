pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/webapplication-repo"
        NGINX_DIR    = "/var/www/html"

        RUN_FRONTEND = "false"
        RUN_BACKEND  = "false"
        RUN_SIMPLEWEB = "false"
    }

    stages {

        stage('Checkout Code') {
            steps {
                script {
                    echo "📥 Pulling latest code..."

                    sh '''
                    if [ ! -d "$PROJECT_DIR/.git" ]; then
                        git clone https://github.com/vijayqadevkraft/webapplication-repo.git $PROJECT_DIR
                    else
                        cd $PROJECT_DIR
                        git pull origin main
                    fi
                    '''
                }
            }
        }

        // 🔥 WEBHOOK BASED CHANGE DETECTION
        stage('Detect Changes') {
            steps {
                script {
                    def changes = env.files ?: "first_run"

                    echo "📦 Webhook REF: ${env.ref}"
                    echo "📂 Changed files: ${changes}"

                    // First run → deploy everything
                    if (changes == "first_run") {
                        env.RUN_FRONTEND = "true"
                        env.RUN_BACKEND  = "true"
                        env.RUN_SIMPLEWEB = "true"
                    }

                    // Full stack app
                    if (changes.contains("app/")) {
                        echo "✅ Full stack app changed"
                        env.RUN_FRONTEND = "true"
                        env.RUN_BACKEND  = "true"
                    }

                    // Simpleweb
                    if (changes.contains("simpleweb/")) {
                        echo "✅ Simpleweb changed"
                        env.RUN_SIMPLEWEB = "true"
                    }
                }
            }
        }

        // 🔥 FULL STACK DEPLOY
        stage('Deploy Full Stack App') {
            when {
                expression { env.RUN_FRONTEND == "true" || env.RUN_BACKEND == "true" }
            }
            steps {
                sh '''
                echo "🚀 Deploying Full Stack App..."

                # Frontend
                sudo mkdir -p /var/www/html/main
                sudo cp -r $PROJECT_DIR/app/frontend/* /var/www/html/main/

                # Backend
                cd $PROJECT_DIR/app/backend
                npm install

                # Restart backend safely
                pkill -f server.js || true
                nohup node server.js > backend.log 2>&1 &
                '''
            }
        }

        // 🔥 SIMPLEWEB DEPLOY
        stage('Deploy SimpleWeb') {
            when {
                expression { env.RUN_SIMPLEWEB == "true" }
            }
            steps {
                sh '''
                echo "🚀 Deploying SimpleWeb..."

                sudo mkdir -p /var/www/html/simpleweb
                sudo cp -r $PROJECT_DIR/simpleweb/* /var/www/html/simpleweb/
                '''
            }
        }

        // 🔥 AUTO NGINX CONFIG (FIXED VERSION)
        stage('Configure Nginx') {
            steps {
                sh '''
                echo "⚙️ Configuring Nginx..."

                sudo tee /etc/nginx/sites-available/default > /dev/null <<EOF
server {
    listen 80;

    location / {
        root /var/www/html/main;
        index index.html;
        try_files \\$uri \\$uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \\$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \\$host;
    }

    location /simpleweb/ {
        alias /var/www/html/simpleweb/;
        index index.html;
    }
}
EOF

                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // 🔥 HEALTH CHECK
        stage('Health Check') {
            steps {
                sh '''
                echo "🌐 Running Health Checks..."

                curl -I http://localhost || exit 1
                curl -I http://localhost/simpleweb/ || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful 🚀"
        }
        failure {
            echo "❌ Deployment failed ❌"
        }
    }
}
