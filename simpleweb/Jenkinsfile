pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/webapplication-repo"
        NGINX_DIR    = "/var/www/html"
        REPO_URL     = "https://github.com/vijayqadevkraft/webapplication-repo.git"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "📥 Checking out code..."
                dir("${PROJECT_DIR}") {
                    git branch: 'main', url: "${REPO_URL}"
                }
            }
        }

        // 🔥 WEBHOOK BASED CHECK (FIXED)
        stage('Check simpleweb Changes') {
            steps {
                script {
                    def changes = env.files ?: "first_run"

                    echo "Changed files from webhook: ${changes}"

                    if (!changes.contains("simpleweb/") && changes != "first_run") {
                        echo "⏭ No simpleweb changes → Skipping deployment"
                        currentBuild.result = 'NOT_BUILT'
                        return
                    }

                    echo "✅ simpleweb changed → Continue"
                }
            }
        }

        stage('Validate File') {
            steps {
                sh '''
                    echo "🔍 Validating simpleweb files..."
                    ls $PROJECT_DIR/simpleweb

                    if [ ! -f "$PROJECT_DIR/simpleweb/index.html" ]; then
                        echo "❌ index.html not found!"
                        exit 1
                    fi
                '''
            }
        }

        // 🔥 SAFE DEPLOY (RSYNC)
        stage('Deploy to Nginx') {
            steps {
                sh '''
                    echo "🚀 Deploying simpleweb..."

                    sudo mkdir -p $NGINX_DIR/simpleweb
                    sudo rsync -av --delete $PROJECT_DIR/simpleweb/ $NGINX_DIR/simpleweb/
                '''
            }
        }

        stage('Reload Nginx') {
            steps {
                sh 'sudo systemctl reload nginx'
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "🌐 Checking simpleweb..."
                    curl -I http://localhost/simpleweb/ || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 SimpleWeb Deployment Successful!"
        }
        failure {
            echo "❌ Deployment Failed!"
        }
        aborted {
            echo "⏭ Skipped (No changes detected)"
        }
    }
}
