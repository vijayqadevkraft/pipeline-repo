pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/webapplication-repo"
        NGINX_DIR    = "/var/www/html"
    }

    stages {

        stage('Checkout Code') {
            steps {
                script {
                    echo "📥 Pulling latest code..."

                    sh '''
                    if [ ! -d "$PROJECT_DIR/.git" ]; then
                        git clone https://github.com/vijayqadevkraft/webapplication-repo.git $PROJECT_DIR
                    else
                        cd $PROJECT_DIR
                        git pull origin main
                    fi
                    '''
                }
            }
        }

        // 🔥 ONLY FOR DEBUG (no flags now)
        stage('Detect Changes') {
            steps {
                script {
                    echo "📦 Webhook REF: ${env.ref}"
                    echo "📂 Changed files: ${env.files}"
                }
            }
        }

        // 🔥 FULL STACK DEPLOY (FIXED)
        stage('Deploy Full Stack App') {
            when {
                expression {
                    return env.files?.toString()?.contains("app/")
                }
            }
            steps {
                sh '''
                echo "🚀 Deploying Full Stack App..."

                sudo mkdir -p /var/www/html/main
                sudo rsync -av --delete $PROJECT_DIR/app/frontend/ /var/www/html/main/

                cd $PROJECT_DIR/app/backend
                npm install

                pkill -f server.js || true
                nohup node server.js > backend.log 2>&1 &
                '''
            }
        }

        // 🔥 SIMPLEWEB DEPLOY (FIXED - MAIN ISSUE)
        stage('Deploy SimpleWeb') {
            when {
                expression {
                    return env.files?.toString()?.contains("simpleweb/")
                }
            }
            steps {
                sh '''
                echo "🚀 Deploying SimpleWeb..."

                sudo mkdir -p /var/www/html/simpleweb
                sudo rsync -av --delete $PROJECT_DIR/simpleweb/ /var/www/html/simpleweb/
                '''
            }
        }

        // 🔥 NGINX CONFIG
        stage('Configure Nginx') {
            steps {
                sh '''
                echo "⚙️ Configuring Nginx..."

                sudo tee /etc/nginx/sites-available/default > /dev/null <<EOF
server {
    listen 80;

    location / {
        root /var/www/html/main;
        index index.html;
        try_files \\$uri \\$uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \\$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \\$host;
    }

    location /simpleweb/ {
        alias /var/www/html/simpleweb/;
        index index.html;
    }
}
EOF

                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // 🔥 HEALTH CHECK
        stage('Health Check') {
            steps {
                sh '''
                echo "🌐 Running Health Checks..."

                curl -I http://localhost || exit 1
                curl -I http://localhost/simpleweb/ || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful 🚀"
        }
        failure {
            echo "❌ Deployment failed ❌"
        }
    }
}
