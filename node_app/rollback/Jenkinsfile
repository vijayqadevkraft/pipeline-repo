pipeline {
    agent any

    environment {
        PROJECT_DIR = "/opt/projects/webapplication-repo"
        BACKUP_DIR  = "/opt/backups/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
    }

    stages {
        stage('Rollback to Last Backup') {
            steps {
                sh '''
#!/bin/bash
set -e

LAST_BACKUP=${BACKUP_DIR}/latest

if [ ! -d "$LAST_BACKUP" ]; then
    echo "❌ No backup found"
    exit 1
fi

rm -rf ${PROJECT_DIR}/*
cp -r $LAST_BACKUP/* ${PROJECT_DIR}/

cd ${BACKEND_DIR}
npm install

pm2 delete ${APP_NAME} || true
pm2 start server.js --name ${APP_NAME}

sleep 5

curl -f http://localhost:3000/health

echo "✅ Rollback successful"
'''
            }
        }
    }
}
