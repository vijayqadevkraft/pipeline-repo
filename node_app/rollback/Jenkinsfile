pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        BACKUP_BASE  = "/opt/backups"
    }

    stages {

        stage('Rollback Application') {
            steps {
                script {
                    echo "🔄 Starting rollback..."

                    sh '''
                        set -e

                        PROJECT_DIR="${BASE_DIR}/${PROJECT_NAME}"
                        BACKUP_PARENT="${BACKUP_BASE}/${PROJECT_NAME}"

                        echo "🛑 Stopping application..."
                        sudo -u ubuntu pm2 delete webapp || true

                        echo "📂 Finding latest backup..."

                        LATEST_BACKUP=$(ls -td ${BACKUP_PARENT}/backup_* 2>/dev/null | head -1)

                        if [ -z "$LATEST_BACKUP" ]; then
                            echo "❌ No backup found. Cannot rollback."
                            exit 1
                        fi

                        echo "📁 Restoring from: $LATEST_BACKUP"

                        # Restore project
                        sudo rm -rf "$PROJECT_DIR"
                        sudo mkdir -p "$PROJECT_DIR"
                        sudo rsync -a "$LATEST_BACKUP"/ "$PROJECT_DIR"/

                        echo "📦 Installing dependencies..."
                        cd "$PROJECT_DIR"
                        npm install || echo "⚠️ npm install skipped"

                        echo "🚀 Starting application..."

                        sudo -u ubuntu pm2 delete webapp || true
                        sudo -u ubuntu pm2 start server.js --name webapp
                        sudo -u ubuntu pm2 save

                        echo "🔍 PM2 Status:"
                        sudo -u ubuntu pm2 list

                        echo "🌐 Restarting Nginx..."
                        sudo systemctl restart nginx

                        echo "🩺 Health Check after rollback..."
                        sleep 5

                        if curl -f http://localhost:3000/health; then
                            echo "✅ Rollback successful and app is running"
                        else
                            echo "❌ Rollback failed - app not responding"
                            exit 1
                        fi

                        echo "📊 Port Check:"
                        netstat -tulnp | grep 3000 || echo "⚠️ Port not active"

                        echo "📜 Last logs:"
                        sudo -u ubuntu pm2 logs webapp --lines 20
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Rollback pipeline successful!"
        }
        failure {
            echo "❌ Rollback pipeline failed!"
        }
    }
}
