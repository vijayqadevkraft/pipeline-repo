pipeline {
    agent any

    environment {
        PROJECT_DIR = "/opt/projects/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
    }

    stages {
        stage('Restart Application') {
            steps {
                sh '''
#!/bin/bash

pm2 restart ${APP_NAME} || {
    echo "App not running → starting fresh"
    cd ${BACKEND_DIR}
    pm2 start server.js --name ${APP_NAME}
}

pm2 save

echo "🔄 Application restarted"
'''
            }
        }
    }
}
