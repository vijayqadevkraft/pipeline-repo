pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Setup Permissions') {
            steps {
                script {
                    echo "🔐 Setting up directory permissions..."

                    sh '''
                        set -e
                        echo "Running as: $(whoami)"

                        sudo mkdir -p ${BASE_DIR}
                        sudo chown -R jenkins:jenkins ${BASE_DIR}
                        sudo chmod -R 755 ${BASE_DIR}

                        ls -ld ${BASE_DIR}
                    '''
                }
            }
        }

        stage('Checkout Code') {
            steps {
                script {
                    echo "📥 Cloning / Updating repository..."

                    sh "mkdir -p ${PROJECT_DIR}"

                    dir("${PROJECT_DIR}") {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${BRANCH}"]],
                            userRemoteConfigs: [[
                                url: "${REPO_URL}"
                            ]]
                        ])
                    }
                }
            }
        }

        stage('Setup Node Environment') {
            steps {
                script {
                    echo "🔧 Ensuring Node.js 18 + npm 9..."

                    sh '''
                        set -e

                        # Install Node 18 if not present
                        if ! node -v | grep -q "v18"; then
                            echo "Installing Node.js 18..."
                            curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -
                            sudo apt-get install -y nodejs
                        fi

                        # Ensure npm v9
                        CURRENT_NPM=$(npm -v | cut -d '.' -f1)
                        if [ "$CURRENT_NPM" -ne "9" ]; then
                            echo "Upgrading npm to v9..."
                            sudo npm install -g npm@9
                        fi

                        echo "Node version: $(node -v)"
                        echo "NPM version: $(npm -v)"
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "📦 Installing dependencies..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}

                        export NODE_OPTIONS=--dns-result-order=ipv4first

                        # Secure npm registry
                        npm config set registry https://registry.npmjs.org/
                        npm config set strict-ssl true

                        if [ -f package-lock.json ]; then
                            echo "✅ Using npm ci"
                            npm ci
                        else
                            echo "⚠️ package-lock.json not found, using npm install"
                            npm install
                        fi
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "🏗️ Building application..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}
                        npm run build || echo "⚠️ No build step"
                    '''
                }
            }
        }

        stage('Deploy with PM2') {
            steps {
                script {
                    echo "🚀 Deploying app..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}

                        # Install PM2 with sudo (fix permission issue)
                        if ! command -v pm2 > /dev/null; then
                            echo "Installing PM2..."
                            sudo npm install -g pm2
                        fi

                        # Restart app cleanly
                        pm2 delete ${APP_NAME} || true
                        pm2 start server.js --name ${APP_NAME}

                        pm2 save
                        pm2 status
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "🩺 Running health check..."

                    sh '''
                        sleep 10

                        curl -f http://localhost:3000/api || {
                            echo "❌ App is not responding"
                            exit 1
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed. Check logs."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
