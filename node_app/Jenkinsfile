pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
        BACKEND_DIR  = "${PROJECT_DIR}/backend"
        BACKUP_DIR   = "/opt/backups/${PROJECT_NAME}"
        APP_NAME     = "webapp"
        REPO_URL     = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH       = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ 1. Setup + Folder Validation
        stage('Setup & Validate Directories') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "🔍 Validating directories..."

                    if [ ! -d "${BASE_DIR}" ]; then
                        echo "📁 Creating BASE_DIR..."
                        sudo mkdir -p ${BASE_DIR}
                    fi

                    if [ ! -d "${BACKUP_DIR}" ]; then
                        echo "📁 Creating BACKUP_DIR..."
                        sudo mkdir -p ${BACKUP_DIR}
                    fi

                    sudo chown -R jenkins:jenkins ${BASE_DIR} ${BACKUP_DIR}
                    sudo chmod -R 755 ${BASE_DIR} ${BACKUP_DIR}

                    echo "✅ Directory validation completed"
                '''
            }
        }

        // ✅ 2. Backup with Validation
        stage('Backup Current Application') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "📦 Creating backup..."

                    TIMESTAMP=$(date +%Y%m%d%H%M%S)
                    BACKUP_PATH=${BACKUP_DIR}/$TIMESTAMP

                    mkdir -p $BACKUP_PATH

                    if [ -d "${PROJECT_DIR}" ] && [ "$(ls -A ${PROJECT_DIR} 2>/dev/null)" ]; then
                        cp -r ${PROJECT_DIR}/* $BACKUP_PATH/

                        if [ "$(ls -A $BACKUP_PATH)" ]; then
                            echo "✅ Backup created at $BACKUP_PATH"
                        else
                            echo "❌ Backup failed (empty)"
                            exit 1
                        fi
                    else
                        echo "⚠️ No existing project to backup"
                    fi
                '''
            }
        }

        // ✅ 3. Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                    set -e

                    if [ ! -d "${PROJECT_DIR}" ]; then
                        mkdir -p ${PROJECT_DIR}
                    fi
                '''

                dir("${PROJECT_DIR}") {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[url: "${REPO_URL}"]]
                    ])
                }
            }
        }

        // ✅ 4. Validate Backend Structure
        stage('Validate Backend') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "🔍 Validating backend structure..."

                    if [ ! -d "${BACKEND_DIR}" ]; then
                        echo "❌ Backend directory missing!"
                        exit 1
                    fi

                    if [ ! -f "${BACKEND_DIR}/server.js" ]; then
                        echo "❌ server.js missing!"
                        exit 1
                    fi

                    if [ ! -f "${BACKEND_DIR}/package.json" ]; then
                        echo "❌ package.json missing!"
                        exit 1
                    fi

                    echo "✅ Backend validation passed"
                '''
            }
        }

        // ✅ 5. Setup Node
        stage('Setup Node') {
            steps {
                sh '''
                    set -e

                    if ! node -v | grep -q "v18"; then
                        curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -
                        sudo apt-get install -y nodejs
                    fi

                    sudo npm install -g npm@9
                    node -v
                    npm -v
                '''
            }
        }

        // ✅ 6. Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                    set -euo pipefail
                    cd ${BACKEND_DIR}

                    echo "📦 Installing dependencies..."
                    npm install
                '''
            }
        }

        // ✅ 7. Build
        stage('Build Application') {
            steps {
                sh '''
                    set -e
                    cd ${BACKEND_DIR}

                    echo "🏗️ Building..."
                    npm run build || echo "⚠️ No build step"
                '''
            }
        }

        // ✅ 8. Safe PM2 Deployment (NO downtime)
        stage('Deploy with PM2') {
            steps {
                sh '''
                    set -e
                    cd ${BACKEND_DIR}

                    if ! command -v pm2 > /dev/null; then
                        sudo npm install -g pm2
                    fi

                    pm2 describe ${APP_NAME} > /dev/null 2>&1

                    if [ $? -eq 0 ]; then
                        echo "🔄 Reloading existing app..."
                        pm2 reload ${APP_NAME}
                    else
                        echo "🚀 Starting new app..."
                        pm2 start server.js --name ${APP_NAME}
                    fi

                    pm2 save
                '''
            }
        }

        // ✅ 9. Configure Nginx
        stage('Configure Nginx') {
            steps {
                sh '''
sudo bash -c 'cat > /etc/nginx/sites-available/default <<EOF
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \\$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \\$host;
    }

    location /api {
        proxy_pass http://localhost:3000;
    }
}
EOF'

                    sudo nginx -t
                    sudo systemctl restart nginx
                '''
            }
        }

        // ✅ 10. Health Check
        stage('Health Check') {
            steps {
                sh '''
                    set -e

                    echo "🩺 Running health check..."

                    for i in {1..5}; do
                        if curl -f http://localhost:3000; then
                            echo "✅ App healthy"
                            exit 0
                        fi
                        sleep 5
                    done

                    echo "❌ Health check failed"
                    exit 1
                '''
            }
        }
    }

    // ✅ 11. ROLLBACK
    post {
        failure {
            script {
                echo "❌ Deployment failed! Starting rollback..."

                sh '''
                    set -e

                    LAST_BACKUP=$(ls -td ${BACKUP_DIR}/* 2>/dev/null | head -1)

                    if [ -z "$LAST_BACKUP" ]; then
                        echo "❌ No backup found!"
                        exit 1
                    fi

                    echo "♻️ Restoring from $LAST_BACKUP"

                    rm -rf ${PROJECT_DIR}/*
                    cp -r $LAST_BACKUP/* ${PROJECT_DIR}/

                    cd ${BACKEND_DIR}
                    npm install

                    pm2 reload ${APP_NAME} || pm2 start server.js --name ${APP_NAME}

                    sleep 5
                    curl -f http://localhost:3000

                    echo "✅ Rollback successful"
                '''
            }
        }

        success {
            echo "✅ Deployment successful!"
        }

        always {
            echo "📋 Pipeline finished"
        }
    }
}
