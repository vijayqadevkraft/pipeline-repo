pipeline {
    agent any

    environment {
        PROJECT_DIR = "/opt/projects/webapplication-repo/backend"
        APP_NAME    = "webapp"
    }

    options {
        timestamps()
    }

    stages {

        stage('Navigate to Project Directory') {
            steps {
                script {
                    echo "📂 Navigating to project directory..."

                    sh '''
                        set -e
                        cd ${PROJECT_DIR}
                        pwd
                    '''
                }
            }
        }

        stage('Pull Latest Code') {
            steps {
                script {
                    echo "📥 Pulling latest code from GitHub..."

                    sh '''
                        set -e
                        cd ${PROJECT_DIR}
                        git pull origin main
                    '''
                }
            }
        }

        stage('Check Node & NPM Version') {
            steps {
                script {
                    echo "🔧 Checking Node.js and npm version..."

                    sh '''
                        set -e

                        echo "Node version: $(node -v)"
                        echo "NPM version: $(npm -v)"

                        CURRENT_NPM=$(npm -v | cut -d '.' -f1)

                        if [ "$CURRENT_NPM" -ne "9" ]; then
                            echo "Updating npm to version 9..."
                            sudo npm install -g npm@9
                        fi
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "📦 Installing dependencies..."

                    sh '''
                        set -e
                        cd ${PROJECT_DIR}

                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "🏗️ Building application..."

                    sh '''
                        set -e
                        cd ${PROJECT_DIR}

                        npm run build || echo "⚠️ No build script found"
                    '''
                }
            }
        }

        stage('Deploy using PM2') {
            steps {
                script {
                    echo "🚀 Deploying application using PM2..."

                    sh '''
                        set -e
                        cd ${PROJECT_DIR}

                        # Install PM2 if not present
                        if ! command -v pm2 > /dev/null; then
                            echo "Installing PM2..."
                            sudo npm install -g pm2
                        fi

                        # Zero downtime deployment
                        if pm2 list | grep -q "${APP_NAME}"; then
                            echo "♻️ Reloading app (zero downtime)..."
                            pm2 reload ${APP_NAME}
                        else
                            echo "🆕 Starting app..."
                            pm2 start server.js --name ${APP_NAME}
                        fi

                        pm2 save
                        pm2 status
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "🩺 Running health check..."

                    sh '''
                        for i in {1..5}; do
                            if curl -f http://localhost:3000/api; then
                                echo "✅ Application is healthy"
                                exit 0
                            fi
                            echo "Retrying in 5 seconds..."
                            sleep 5
                        done

                        echo "❌ Health check failed"
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed. Check logs."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
