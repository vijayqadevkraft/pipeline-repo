pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Setup Permissions') {
            steps {
                script {
                    echo "🔐 Setting up directory permissions..."

                    sh '''
                        set -e
                        sudo mkdir -p ${BASE_DIR}
                        sudo chown -R jenkins:jenkins ${BASE_DIR}
                        sudo chmod -R 755 ${BASE_DIR}
                    '''
                }
            }
        }

        stage('Checkout Code') {
            steps {
                script {
                    echo "📥 Cloning repository..."

                    sh "mkdir -p ${PROJECT_DIR}"

                    dir("${PROJECT_DIR}") {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${BRANCH}"]],
                            userRemoteConfigs: [[url: "${REPO_URL}"]]
                        ])
                    }
                }
            }
        }

        stage('Setup Node Environment') {
            steps {
                script {
                    echo "🔧 Ensuring Node.js 18 + npm 9..."

                    sh '''
                        set -e

                        if ! node -v | grep -q "v18"; then
                            curl -fsSL https://deb.nodesource.com/setup_18.x | sudo -E bash -
                            sudo apt-get install -y nodejs
                        fi

                        CURRENT_NPM=$(npm -v | cut -d '.' -f1)
                        if [ "$CURRENT_NPM" -ne "9" ]; then
                            sudo npm install -g npm@9
                        fi

                        node -v
                        npm -v
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "📦 Installing dependencies..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}

                        export NODE_OPTIONS=--dns-result-order=ipv4first

                        npm config set registry https://registry.npmjs.org/
                        npm config set strict-ssl true

                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "🏗️ Building application..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}
                        npm run build || echo "⚠️ No build step"
                    '''
                }
            }
        }

        stage('Deploy with PM2') {
            steps {
                script {
                    echo "🚀 Deploying app..."

                    sh '''
                        set -e
                        cd ${BACKEND_DIR}

                        # Install PM2 if not exists
                        if ! command -v pm2 > /dev/null; then
                            sudo npm install -g pm2
                        fi

                        # Restart app cleanly
                        pm2 delete ${APP_NAME} || true
                        pm2 start server.js --name ${APP_NAME}

                        # Save for auto-start
                        pm2 save

                        # Setup startup (safe to run multiple times)
                        pm2 startup systemd -u jenkins --hp /var/lib/jenkins || true

                        pm2 status
                    '''
                }
            }
        }

        stage('Configure Nginx') {
            steps {
                script {
                    echo "🌐 Configuring Nginx..."

                    sh '''
                        sudo bash -c 'cat > /etc/nginx/sites-available/default <<EOF
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_cache_bypass \$http_upgrade;
    }
}
EOF'

                        sudo nginx -t
                        sudo systemctl restart nginx
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "🩺 Running health check..."

                    sh '''
                        for i in {1..5}; do
                            if curl -f http://localhost:3000/api; then
                                echo "✅ App is healthy"
                                exit 0
                            fi
                            echo "Retrying in 5 seconds..."
                            sleep 5
                        done

                        echo "❌ App failed health check"
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed. Check logs."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
