pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        BACKUP_BASE  = "/opt/backups"
    }

    stages {

        stage('Backup Application') {
            steps {
                script {
                    echo "📦 Taking validated backup..."

                    sh '''
                        set -e

                        PROJECT_DIR="${BASE_DIR}/${PROJECT_NAME}"
                        BACKUP_PARENT="${BACKUP_BASE}/${PROJECT_NAME}"

                        # =========================
                        # 1. Check project exists
                        # =========================
                        if [ ! -d "$PROJECT_DIR" ]; then
                            echo "❌ Project directory not found"
                            exit 1
                        fi

                        # =========================
                        # 2. Create timestamp backup
                        # =========================
                        TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
                        BACKUP_DIR="${BACKUP_PARENT}/backup_$TIMESTAMP"

                        echo "📁 Creating backup: $BACKUP_DIR"

                        sudo mkdir -p "$BACKUP_DIR"

                        # Copy project
                        sudo rsync -a "$PROJECT_DIR"/ "$BACKUP_DIR"/

                        # =========================
                        # 3. VALIDATION START
                        # =========================
                        echo "🔍 Validating backup..."

                        # Check backup exists
                        if [ ! -d "$BACKUP_DIR" ]; then
                            echo "❌ Backup not created"
                            exit 1
                        fi

                        # Check not empty
                        if [ -z "$(ls -A $BACKUP_DIR)" ]; then
                            echo "❌ Backup is empty"
                            exit 1
                        fi

                        # =========================
                        # 4. BACKEND VALIDATION (ROOT)
                        # =========================
                        echo "🔧 Checking backend..."

                        if [ ! -f "$BACKUP_DIR/server.js" ]; then
                            echo "❌ server.js missing"
                            exit 1
                        fi

                        if [ ! -f "$BACKUP_DIR/package.json" ]; then
                            echo "❌ package.json missing"
                            exit 1
                        fi

                        echo "✅ Backend validation passed"

                        # =========================
                        # 5. FRONTEND VALIDATION
                        # =========================
                        echo "🎨 Checking frontend..."

                        if [ -d "$BACKUP_DIR/frontend" ]; then
                            echo "📁 Frontend folder found"

                            if [ ! -f "$BACKUP_DIR/frontend/index.html" ] && [ ! -f "$BACKUP_DIR/frontend/package.json" ]; then
                                echo "❌ Frontend files missing"
                                exit 1
                            fi

                            echo "✅ Frontend validation passed"
                        else
                            echo "⚠️ No frontend folder found (optional)"
                        fi

                        # =========================
                        # 6. FILE COUNT CHECK
                        # =========================
                        SRC_COUNT=$(find "$PROJECT_DIR" | wc -l)
                        DEST_COUNT=$(find "$BACKUP_DIR" | wc -l)

                        echo "📊 Source files: $SRC_COUNT"
                        echo "📊 Backup files: $DEST_COUNT"

                        if [ "$DEST_COUNT" -lt "$SRC_COUNT" ]; then
                            echo "❌ Backup incomplete"
                            exit 1
                        fi

                        # =========================
                        # 7. CLEAN OLD BACKUPS
                        # =========================
                        echo "🧹 Keeping last 5 backups..."

                        cd "$BACKUP_PARENT"
                        ls -dt backup_* | tail -n +6 | xargs -r rm -rf

                        echo "📂 Available backups:"
                        ls -dt backup_*

                        echo "✅ Backup completed and validated successfully"
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Backup pipeline successful!"
        }
        failure {
            echo "❌ Backup pipeline failed!"
        }
    }
}
