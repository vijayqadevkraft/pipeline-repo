pipeline {
    agent any

    stages {

        stage('Backup Application') {
            steps {
                script {
                    echo "📦 Taking full validated backup..."

                    sh '''
                        set -e

                        PROJECT_NAME="webapplication-repo"
                        BASE_DIR="/opt/projects"
                        BACKUP_BASE="/opt/backups"

                        PROJECT_DIR="${BASE_DIR}/${PROJECT_NAME}"
                        BACKUP_PARENT="${BACKUP_BASE}/${PROJECT_NAME}"

                        if [ ! -d "$PROJECT_DIR" ]; then
                            echo "❌ Project directory not found"
                            exit 1
                        fi

                        # Create timestamp backup
                        TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
                        BACKUP_DIR="${BACKUP_PARENT}/backup_$TIMESTAMP"

                        echo "📁 Creating backup: $BACKUP_DIR"

                        sudo mkdir -p "$BACKUP_DIR"
                        sudo rsync -a "$PROJECT_DIR"/ "$BACKUP_DIR"/

                        echo "🔍 Starting deep validation..."

                        # =========================
                        # 1. Basic Validation
                        # =========================
                        if [ ! -d "$BACKUP_DIR" ]; then
                            echo "❌ Backup not created"
                            exit 1
                        fi

                        if [ -z "$(ls -A $BACKUP_DIR)" ]; then
                            echo "❌ Backup is empty"
                            exit 1
                        fi

                        # =========================
                        # 2. Backend Validation
                        # =========================
                        if [ -d "$BACKUP_DIR/backend" ]; then
                            echo "📦 Backend detected"

                            if [ ! -f "$BACKUP_DIR/backend/package.json" ]; then
                                echo "❌ Backend package.json missing"
                                exit 1
                            fi

                            if [ ! -f "$BACKUP_DIR/backend/server.js" ]; then
                                echo "❌ Backend server.js missing"
                                exit 1
                            fi
                        else
                            echo "📦 Root-level backend detected"

                            if [ ! -f "$BACKUP_DIR/package.json" ]; then
                                echo "❌ package.json missing"
                                exit 1
                            fi
                        fi

                        # =========================
                        # 3. Frontend Validation
                        # =========================
                        if [ -d "$BACKUP_DIR/frontend" ]; then
                            echo "🎨 Frontend detected"

                            if [ ! -f "$BACKUP_DIR/frontend/package.json" ]; then
                                echo "❌ Frontend package.json missing"
                                exit 1
                            fi

                            # Optional build check
                            if [ ! -d "$BACKUP_DIR/frontend/build" ] && [ ! -d "$BACKUP_DIR/frontend/dist" ]; then
                                echo "⚠️ No frontend build found (optional)"
                            fi
                        else
                            echo "ℹ️ No frontend folder found (skipping)"
                        fi

                        # =========================
                        # 4. File Count Validation
                        # =========================
                        SRC_COUNT=$(find "$PROJECT_DIR" | wc -l)
                        DEST_COUNT=$(find "$BACKUP_DIR" | wc -l)

                        echo "📊 Source files: $SRC_COUNT"
                        echo "📊 Backup files: $DEST_COUNT"

                        if [ "$DEST_COUNT" -lt "$SRC_COUNT" ]; then
                            echo "❌ Backup incomplete"
                            exit 1
                        fi

                        # =========================
                        # 5. Backup Integrity (Optional Advanced)
                        # =========================
                        echo "🔐 Checking backup integrity..."

                        SRC_SUM=$(tar cf - "$PROJECT_DIR" | md5sum)
                        DEST_SUM=$(tar cf - "$BACKUP_DIR" | md5sum)

                        if [ "$SRC_SUM" != "$DEST_SUM" ]; then
                            echo "❌ Backup corrupted (checksum mismatch)"
                            exit 1
                        fi

                        # =========================
                        # 6. Retention Policy
                        # =========================
                        echo "🧹 Keeping last 5 backups..."

                        cd "$BACKUP_PARENT"
                        ls -dt backup_* | tail -n +6 | xargs -r rm -rf

                        echo "📂 Available backups:"
                        ls -dt backup_*

                        echo "✅ Backup validation PASSED (end-to-end)"
                    '''
                }
            }
        }

    }
}
