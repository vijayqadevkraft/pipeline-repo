stage('Backup Application') {
    steps {
        script {
            echo "📦 Taking full app backup (simple copy)..."

            sh '''
                set -e

                PROJECT_NAME="webapplication-repo"
                BASE_DIR="/opt/projects"
                BACKUP_BASE="/opt/backups"

                PROJECT_DIR="${BASE_DIR}/${PROJECT_NAME}"
                BACKUP_DIR="${BACKUP_BASE}/${PROJECT_NAME}"

                # Check project exists
                if [ ! -d "$PROJECT_DIR" ]; then
                    echo "❌ Project directory not found: $PROJECT_DIR"
                    exit 1
                fi

                echo "🧹 Cleaning old backup..."
                sudo rm -rf "$BACKUP_DIR"

                echo "📁 Creating backup directory..."
                sudo mkdir -p "$BACKUP_DIR"

                echo "📦 Copying full project..."
                sudo rsync -a "$PROJECT_DIR"/ "$BACKUP_DIR"/

                echo "📄 Creating manifest..."
                sudo find "$BACKUP_DIR" -type f > "$BACKUP_DIR/manifest.txt"

                echo "📊 Backup size:"
                sudo du -sh "$BACKUP_DIR"

                echo "✅ Backup completed successfully at: $BACKUP_DIR"
            '''
        }
    }
}
