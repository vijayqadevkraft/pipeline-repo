pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
        BACKEND_DIR  = "${PROJECT_DIR}/backend"
        APP_NAME     = "webapp"
        REPO_URL     = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH       = "main"
    }

    options {
        timestamps()
    }

    stages {

        // ✅ Checkout
        stage('Checkout Code') {
            steps {
                dir("${PROJECT_DIR}") {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[url: "${REPO_URL}"]]
                    ])
                }
            }
        }

        // ✅ Install
        stage('Install Dependencies') {
            steps {
                sh '''
cd ${BACKEND_DIR}
npm install
'''
            }
        }

        // ✅ Detect Current Running Port
        stage('Detect Current App') {
            steps {
                script {
                    env.CURRENT_PORT = sh(
                        script: "ss -tuln | grep 3000 && echo 3000 || echo 3001",
                        returnStdout: true
                    ).trim()

                    if (env.CURRENT_PORT == "3000") {
                        env.NEW_PORT = "3001"
                    } else {
                        env.NEW_PORT = "3000"
                    }

                    echo "Current Port: ${env.CURRENT_PORT}"
                    echo "New Port: ${env.NEW_PORT}"
                }
            }
        }

        // ✅ Deploy New Version (NO IMPACT)
        stage('Deploy New Version') {
            steps {
                sh '''
cd ${BACKEND_DIR}

pm2 delete webapp-${NEW_PORT} || true

PORT=${NEW_PORT} pm2 start server.js --name webapp-${NEW_PORT}

sleep 5
'''
            }
        }

        // ✅ Validate New App BEFORE Switch
        stage('Validate New Version') {
            steps {
                sh '''
#!/bin/bash
set -e

echo "🔍 Validating new app on port ${NEW_PORT}..."

curl -f http://localhost:${NEW_PORT}/health
curl -f http://localhost:${NEW_PORT}/api
curl -s http://localhost:${NEW_PORT} | grep "html"

echo "✅ New version is healthy"
'''
            }
        }

        // ✅ Switch Traffic (ZERO DOWNTIME)
        stage('Switch Traffic (Nginx)') {
            steps {
                sh '''
sudo bash -c "cat > /etc/nginx/sites-available/default <<EOF
server {
    listen 80;

    location / {
        proxy_pass http://localhost:${NEW_PORT};
    }

    location /api {
        proxy_pass http://localhost:${NEW_PORT};
    }
}
EOF"

sudo nginx -t
sudo systemctl reload nginx

echo "🔄 Traffic switched to ${NEW_PORT}"
'''
            }
        }

        // ✅ Cleanup Old Version
        stage('Cleanup Old Version') {
            steps {
                sh '''
pm2 delete webapp-${CURRENT_PORT} || true
'''
            }
        }
    }

    post {
        failure {
            echo "❌ Deployment failed → keeping old version running (NO downtime)"
        }

        success {
            echo "✅ Zero downtime deployment successful"
        }

        always {
            echo "📋 Pipeline finished"
        }
    }
}
