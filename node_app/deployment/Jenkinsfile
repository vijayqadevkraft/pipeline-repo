pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        PROJECT_DIR = "app_repo"
        RUN_FRONTEND = "false"
        RUN_BACKEND  = "false"
        RUN_SIMPLEWEB = "false"
    }

    stages {

        stage('Checkout Code') {
            steps {
                script {
                    sh '''
                    if [ ! -d "app_repo/.git" ]; then
                        git clone -b main https://github.com/vijayqadevkraft/webapplication-repo.git app_repo
                    else
                        cd app_repo && git pull origin main
                    fi
                    '''
                }
            }
        }

        // 🔥 WEBHOOK BASED CHANGE DETECTION
        stage('Detect Changes') {
            steps {
                script {
                    def changes = env.files ?: "first_run"

                    echo "Changed files from webhook: ${changes}"

                    if (changes == "first_run") {
                        env.RUN_FRONTEND = "true"
                        env.RUN_BACKEND  = "true"
                        env.RUN_SIMPLEWEB = "true"
                    }

                    if (changes.contains("app/")) {
                        echo "✅ Full stack app changed"
                        env.RUN_FRONTEND = "true"
                        env.RUN_BACKEND  = "true"
                    }

                    if (changes.contains("simpleweb/")) {
                        echo "✅ Simpleweb changed"
                        env.RUN_SIMPLEWEB = "true"
                    }
                }
            }
        }

        // 🔥 FULL STACK DEPLOY
        stage('Deploy Full Stack App') {
            when {
                expression { env.RUN_FRONTEND == "true" || env.RUN_BACKEND == "true" }
            }
            steps {
                sh '''
                echo "🚀 Deploying full stack app..."

                # frontend (safe sync)
                sudo mkdir -p /var/www/html/main
                sudo rsync -av --delete app_repo/app/frontend/ /var/www/html/main/

                # backend
                cd app_repo/app/backend
                npm install

                # safe restart
                pkill -f server.js || true
                nohup node server.js > backend.log 2>&1 &
                '''
            }
        }

        // 🔥 SIMPLEWEB DEPLOY
        stage('Deploy SimpleWeb') {
            when {
                expression { env.RUN_SIMPLEWEB == "true" }
            }
            steps {
                sh '''
                echo "🚀 Deploying simpleweb..."

                sudo mkdir -p /var/www/html/simpleweb
                sudo rsync -av --delete app_repo/simpleweb/ /var/www/html/simpleweb/
                '''
            }
        }

        // 🔥 NGINX CONFIG (IDEMPOTENT)
        stage('Configure Nginx') {
            steps {
                sh '''
                echo "⚙️ Configuring Nginx..."

                sudo tee /etc/nginx/sites-available/default > /dev/null <<EOF
server {
    listen 80;

    location / {
        root /var/www/html/main;
        index index.html;
        try_files \$uri \$uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
    }

    location /simpleweb/ {
        alias /var/www/html/simpleweb/;
        index index.html;
    }
}
EOF

                sudo nginx -t
                sudo systemctl reload nginx
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                echo "🌐 Checking app..."

                curl -I http://localhost || exit 1
                curl -I http://localhost/simpleweb/ || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Fully automated deployment successful"
        }
        failure {
            echo "❌ Deployment failed"
        }
    }
}
