pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
        APP_NAME    = "webapp"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup Directory
        stage('Setup Directory') {
            steps {
                sh 'mkdir -p ${BASE_DIR}'
            }
        }

        // ✅ Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                if [ -d "${PROJECT_DIR}/.git" ]; then
                    cd ${PROJECT_DIR}
                    git fetch origin
                    git reset --hard origin/${BRANCH}
                else
                    rm -rf ${PROJECT_DIR}
                    git clone ${REPO_URL} ${PROJECT_DIR}
                fi
                '''
            }
        }

        // ✅ Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${BACKEND_DIR}
                npm install
                '''
            }
        }

        // ✅ Deploy Application (STABLE)
        stage('Deploy Application') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                echo "🚀 Starting application..."

                # Ensure PM2 exists
                command -v pm2 >/dev/null || npm install -g pm2

                # Restart app cleanly
                pm2 delete ${APP_NAME} || true
                pm2 start server.js --name ${APP_NAME}

                # Save process
                pm2 save

                echo "✅ PM2 running:"
                pm2 list
                '''
            }
        }

        // ✅ Restart Nginx
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health Check
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Checking application..."

                sleep 5

                curl -f http://localhost:3000/health || {
                    echo "❌ Backend failed"
                    exit 1
                }

                curl -f http://localhost || {
                    echo "❌ Nginx failed"
                    exit 1
                }

                echo "✅ Application is running successfully"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
