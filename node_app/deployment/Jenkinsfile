pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup (ONLY FIRST TIME NEEDED)
        stage('Setup Directory') {
            steps {
                sh '''
                mkdir -p ${BASE_DIR}
                mkdir -p ${PROJECT_DIR}
                '''
            }
        }

        // ✅ Checkout Code (FIXED PROPERLY)
        stage('Checkout Code') {
            steps {
                sh '''
                if [ -d "${PROJECT_DIR}/.git" ]; then
                    echo "🔄 Updating repo..."
                    cd ${PROJECT_DIR}
                    git fetch origin
                    git reset --hard origin/${BRANCH}
                else
                    echo "📥 Fresh clone..."
                    rm -rf ${PROJECT_DIR}/*
                    git clone ${REPO_URL} ${PROJECT_DIR}
                fi
                '''
            }
        }

        // ✅ Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                export NODE_OPTIONS=--dns-result-order=ipv4first

                if [ -f package-lock.json ]; then
                    npm ci
                else
                    npm install
                fi
                '''
            }
        }

        // ✅ Start / Restart App
        stage('Deploy Application') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                command -v pm2 >/dev/null || npm install -g pm2

                pm2 delete ${APP_NAME} || true
                pm2 start server.js --name ${APP_NAME}
                pm2 save

                pm2 list
                '''
            }
        }

        // ✅ Restart Nginx (SAFE)
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health Check (STRONG)
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Checking app..."

                for i in {1..5}; do
                    if curl -f http://localhost:3000; then
                        echo "✅ Backend OK"
                        break
                    fi
                    echo "Retrying..."
                    sleep 5
                done

                curl -f http://localhost || exit 1

                echo "✅ Deployment Verified"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
