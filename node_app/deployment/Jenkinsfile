pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
        APP_NAME    = "webapp"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup Directory
        stage('Setup Directory') {
            steps {
                sh '''
                mkdir -p ${BASE_DIR}
                '''
            }
        }

        // ✅ Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                if [ -d "${PROJECT_DIR}/.git" ]; then
                    echo "🔄 Updating existing repo..."
                    cd ${PROJECT_DIR}
                    git fetch origin
                    git reset --hard origin/${BRANCH}
                else
                    echo "📥 Fresh clone..."
                    rm -rf ${PROJECT_DIR}
                    git clone ${REPO_URL} ${PROJECT_DIR}
                fi
                '''
            }
        }

        // ✅ Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                echo "📂 Current directory:"
                pwd
                ls

                echo "📦 Installing dependencies..."
                npm install
                '''
            }
        }

        // ✅ Start Application (FIXED)
        stage('Start Application') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                echo "🚀 Starting application..."
                pwd
                ls

                # Install PM2 if not exists
                command -v pm2 >/dev/null || npm install -g pm2

                # Kill old app
                pm2 delete ${APP_NAME} || true

                # Start new app
                pm2 start server.js --name ${APP_NAME}

                sleep 5

                # Verify app started
                pm2 list | grep ${APP_NAME} || {
                    echo "❌ App failed to start"
                    exit 1
                }

                pm2 save
                '''
            }
        }

        // ✅ Restart Nginx
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health Check
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Checking application..."

                sleep 5

                curl -f http://localhost:3000/health || {
                    echo "❌ Backend not reachable"
                    exit 1
                }

                curl -f http://localhost || {
                    echo "❌ Nginx not routing"
                    exit 1
                }

                echo "✅ Application is running successfully"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
