pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Stage 1: Setup Directory
        stage('Setup Directory') {
            steps {
                sh '''
                mkdir -p ${BASE_DIR}
                '''
            }
        }

        // ✅ Stage 2: Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                if [ -d "${PROJECT_DIR}/.git" ]; then
                    echo "🔄 Updating repo..."
                    cd ${PROJECT_DIR}
                    git fetch origin
                    git reset --hard origin/${BRANCH}
                else
                    echo "📥 Cloning repo..."
                    rm -rf ${PROJECT_DIR}
                    git clone ${REPO_URL} ${PROJECT_DIR}
                fi
                '''
            }
        }

        // ✅ Stage 3: Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${BACKEND_DIR}
                npm install
                '''
            }
        }

        // ✅ Stage 4: Deploy Application (ZERO DOWNTIME)
        stage('Deploy Application') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                echo "🚀 Deploying application..."

                # Ensure PM2 is installed
                command -v pm2 >/dev/null || npm install -g pm2

                # ✅ Zero-downtime deploy:
                #    First run  → pm2 reload fails → pm2 start (fresh start)
                #    Next runs  → pm2 reload succeeds (no downtime, no 502)
                pm2 reload ${APP_NAME} --update-env || pm2 start server.js --name ${APP_NAME}

                sleep 3

                # Verify app is running
                pm2 list | grep ${APP_NAME} || {
                    echo "❌ App failed to start"
                    exit 1
                }

                # Save PM2 process list
                pm2 save

                echo "✅ App deployed successfully"
                '''
            }
        }

        // ✅ Stage 5: Restart Nginx
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Stage 6: Health Check
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Running health check..."

                for i in {1..5}; do
                    if curl -sf http://localhost:3000/health; then
                        echo "✅ Backend OK"
                        break
                    fi
                    echo "⏳ Attempt $i failed, retrying in 5s..."
                    sleep 5
                done

                curl -f http://localhost || {
                    echo "❌ Nginx check failed"
                    exit 1
                }

                echo "✅ Deployment verified"
                '''
            }
        }

    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
            sh 'pm2 logs ${APP_NAME} --lines 20 --nostream || true'
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
