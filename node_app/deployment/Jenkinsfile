pipeline {
    agent any

    environment {
        BASE_DIR    = "/opt/projects"
        PROJECT_DIR = "${BASE_DIR}/webapplication-repo"
        BACKEND_DIR = "${PROJECT_DIR}/backend"
        APP_NAME    = "webapp"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup Directory
        stage('Setup Directory') {
            steps {
                sh '''
                mkdir -p ${BASE_DIR}
                '''
            }
        }

        // ✅ Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                if [ -d "${PROJECT_DIR}/.git" ]; then
                    echo "🔄 Updating repo..."
                    cd ${PROJECT_DIR}
                    git fetch origin
                    git reset --hard origin/${BRANCH}
                else
                    echo "📥 Cloning repo..."
                    rm -rf ${PROJECT_DIR}
                    git clone ${REPO_URL} ${PROJECT_DIR}
                fi
                '''
            }
        }

        // ✅ Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${BACKEND_DIR}
                npm install
                '''
            }
        }

        // ✅ Deploy Application (FIXED)
        stage('Deploy Application') {
            steps {
                sh '''
                cd ${BACKEND_DIR}

                echo "🚀 Deploying application..."

                # Ensure PM2 installed
                command -v pm2 >/dev/null || npm install -g pm2

                # Stop old app
                pm2 delete ${APP_NAME} || true

                # Start app
                pm2 start server.js --name ${APP_NAME}

                sleep 5

                # Verify app running
                pm2 list | grep ${APP_NAME} || {
                    echo "❌ App failed to start"
                    exit 1
                }

                # Save PM2 process (important)
                pm2 save

                echo "✅ App started successfully"
                '''
            }
        }

        // ✅ Restart Nginx
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health Check (STRONG)
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Running health check..."

                for i in {1..5}; do
                    if curl -f http://localhost:3000/health; then
                        echo "✅ Backend OK"
                        break
                    fi
                    echo "Retrying..."
                    sleep 5
                done

                curl -f http://localhost || {
                    echo "❌ Nginx failed"
                    exit 1
                }

                echo "✅ Deployment verified"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
