pipeline {
    agent any

    // 🔥 Webhook trigger
    triggers {
        githubPush()
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        BASE_DIR     = "/opt/projects"
        PROJECT_NAME = "webapplication-repo"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
        RUN_FRONTEND = "false"
    }

    stages {

        stage('Checkout Pipeline Repo') {
            steps {
                checkout scm
            }
        }

        stage('Checkout App Repo') {
            steps {
                dir('app') {
                    git branch: 'main', url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        // ✅ FIXED CHANGE DETECTION (more reliable)
        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(
                        script: """
                            cd app
                            git fetch origin main
                            git diff --name-only origin/main~1 origin/main || true
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Changed files: ${changes}"

                    if (changes.contains("frontend/")) {
                        env.RUN_FRONTEND = "true"
                        echo "✅ Frontend changes detected"
                    } else {
                        echo "❌ No frontend changes"
                    }
                }
            }
        }

        stage('Setup Permissions') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sudo mkdir -p /opt/projects
                    sudo chown -R jenkins:jenkins /opt/projects
                '''
            }
        }

        stage('Copy Code') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    rm -rf ${PROJECT_DIR}
                    mkdir -p ${PROJECT_DIR}
                    cp -r app/* ${PROJECT_DIR}/
                '''
            }
        }

        stage('Install Dependencies') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm install
                '''
            }
        }

        stage('Build Application') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm run build || echo "No build step"
                '''
            }
        }

        stage('Deploy with PM2') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend

                    if ! command -v pm2 > /dev/null; then
                        sudo npm install -g pm2
                    fi

                    sudo -u ubuntu pm2 restart webapp || sudo -u ubuntu pm2 start server.js --name webapp
                    sudo -u ubuntu pm2 save
                '''
            }
        }

        stage('Restart Nginx') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sudo systemctl restart nginx
                '''
            }
        }

        stage('Health Check') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:3000/health
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
