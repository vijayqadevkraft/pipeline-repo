pipeline {
    agent any

    environment {
        PROJECT_DIR = "/opt/projects/webapplication-repo/backend"
        BASE_DIR    = "/opt/projects"
        REPO_URL    = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH      = "main"
        APP_NAME    = "webapp"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup Directory with Permissions
        stage('Setup Permissions') {
            steps {
                sh '''
                # Create base directory if not exists
                [ -d "${BASE_DIR}" ] || sudo mkdir -p ${BASE_DIR}

                # Set ownership to Jenkins user
                sudo chown -R jenkins:jenkins ${BASE_DIR}

                # Set permissions
                sudo chmod -R 755 ${BASE_DIR}

                # Create project directory
                mkdir -p ${PROJECT_DIR}
                '''
            }
        }

        // ✅ Checkout Code
        stage('Checkout Code') {
            steps {
                sh '''
                if [ ! -d "${PROJECT_DIR}/.git" ]; then
                    git clone ${REPO_URL} ${PROJECT_DIR}
                else
                    cd ${PROJECT_DIR}
                    git pull origin ${BRANCH}
                fi
                '''
            }
        }

        // ✅ Install Dependencies
        stage('Install Dependencies') {
            steps {
                sh '''
                cd ${PROJECT_DIR}
                npm install
                '''
            }
        }

        // ✅ Start App
        stage('Start Application') {
            steps {
                sh '''
                cd ${PROJECT_DIR}

                # Install PM2 if not exists
                command -v pm2 >/dev/null || npm install -g pm2

                pm2 delete ${APP_NAME} || true
                pm2 start server.js --name ${APP_NAME}
                pm2 save
                '''
            }
        }

        // ✅ Restart Nginx
        stage('Restart Nginx') {
            steps {
                sh '''
                sudo nginx -t
                sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health Check
        stage('Health Check') {
            steps {
                sh '''
                echo "🔍 Checking application..."

                sleep 5

                pm2 list
                curl -f http://localhost:3000 || exit 1
                curl -f http://localhost || exit 1

                echo "✅ App is running successfully"
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment Successful 🚀"
        }
        failure {
            echo "❌ Deployment Failed"
        }
        always {
            echo "📋 Pipeline Finished"
        }
    }
}
