pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        RUN_FRONTEND = "false"
    }

    stages {

        stage('Checkout Pipeline Repo') {
            steps {
                checkout scm
            }
        }

        stage('Checkout App Repo') {
            steps {
                dir('app') {
                    git branch: 'main',
                        url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(
                        script: "cd app && git fetch origin main && git diff --name-only origin/main~1 origin/main",
                        returnStdout: true
                    ).trim()

                    echo "Changed files in app repo: ${changes}"

                    if (changes.contains("frontend/")) {
                        echo "✅ Frontend changes detected"
                        env.RUN_FRONTEND = "true"
                    } else {
                        echo "❌ No frontend changes"
                        env.RUN_FRONTEND = "false"
                    }
                }
            }
        }

        stage('Setup Permissions') {
            steps {
                script {
                    if (env.RUN_FRONTEND == "true") {
                        echo "🔧 Setting permissions..."
                        sh "sudo chmod -R 755 /var/www/html"
                    } else {
                        echo "⏭ Skipping Setup Permissions"
                    }
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                script {
                    if (env.RUN_FRONTEND == "true") {
                        echo "📂 Deploying frontend..."

                        sh """
                        sudo rm -rf /var/www/html/*
                        sudo cp -r app/frontend/* /var/www/html/
                        """
                    } else {
                        echo "⏭ Skipping Deployment"
                    }
                }
            }
        }

        stage('Restart Nginx') {
            steps {
                script {
                    if (env.RUN_FRONTEND == "true") {
                        echo "🔄 Restarting Nginx..."
                        sh "sudo systemctl restart nginx"
                    } else {
                        echo "⏭ Skipping Nginx Restart"
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    if (env.RUN_FRONTEND == "true") {
                        echo "🌐 Checking app..."
                        sh "curl -I http://localhost || exit 1"
                    } else {
                        echo "⏭ Skipping Health Check"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "📋 Pipeline finished."
        }
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed!"
        }
    }
}
