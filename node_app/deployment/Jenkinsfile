pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        RUN_FRONTEND = "false"
        RUN_BACKEND  = "false"
        RUN_SIMPLEWEB = "false"
    }

    stages {

        stage('Checkout Code') {
            steps {
                dir('app_repo') {
                    git branch: 'main',
                        url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(
                        script: "cd app_repo && git fetch origin main && git diff --name-only origin/main~1 origin/main",
                        returnStdout: true
                    ).trim()

                    echo "Changed files: ${changes}"

                    if (changes.contains("app/frontend/")) {
                        env.RUN_FRONTEND = "true"
                    }

                    if (changes.contains("app/backend/")) {
                        env.RUN_BACKEND = "true"
                    }

                    if (changes.contains("simpleweb/")) {
                        env.RUN_SIMPLEWEB = "true"
                    }
                }
            }
        }

        stage('Deploy Frontend') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh """
                echo "🚀 Deploying frontend..."
                sudo rm -rf /var/www/html/main
                sudo mkdir -p /var/www/html/main
                sudo cp -r app_repo/app/frontend/* /var/www/html/main/
                """
            }
        }

        stage('Deploy SimpleWeb') {
            when {
                expression { env.RUN_SIMPLEWEB == "true" }
            }
            steps {
                sh """
                echo "🚀 Deploying simpleweb..."
                sudo rm -rf /var/www/html/simpleweb
                sudo mkdir -p /var/www/html/simpleweb
                sudo cp -r app_repo/simpleweb/* /var/www/html/simpleweb/
                """
            }
        }

        stage('Start Backend') {
            when {
                expression { env.RUN_BACKEND == "true" }
            }
            steps {
                sh """
                echo "🚀 Starting backend..."
                cd app_repo/app/backend
                npm install
                pkill node || true
                nohup node server.js > backend.log 2>&1 &
                """
            }
        }

        stage('Restart Nginx') {
            steps {
                sh "sudo systemctl restart nginx"
            }
        }

        stage('Health Check') {
            steps {
                sh "curl -I http://localhost || exit 1"
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful"
        }
        failure {
            echo "❌ Deployment failed"
        }
    }
}
