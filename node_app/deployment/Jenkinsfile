pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
        BACKEND_DIR  = "${PROJECT_DIR}/backend"
        BACKUP_DIR   = "/opt/backups/${PROJECT_NAME}"
        APP_NAME     = "webapp"
        REPO_URL     = "https://github.com/vijayqadevkraft/webapplication-repo.git"
        BRANCH       = "main"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ✅ Setup
        stage('Setup & Validate Directories') {
            steps {
                sh '''
#!/bin/bash
set -e
[ -d "${BASE_DIR}" ] || sudo mkdir -p ${BASE_DIR}
[ -d "${BACKUP_DIR}" ] || sudo mkdir -p ${BACKUP_DIR}
sudo chown -R jenkins:jenkins ${BASE_DIR} ${BACKUP_DIR}
sudo chmod -R 755 ${BASE_DIR} ${BACKUP_DIR}
'''
            }
        }

        // ✅ Backup FIRST (CRITICAL)
        stage('Backup Current Application') {
            steps {
                sh '''
#!/bin/bash
set -e

TIMESTAMP=$(date +%H%M%S)
BACKUP_PATH=${BACKUP_DIR}/$TIMESTAMP
mkdir -p $BACKUP_PATH

if [ -d "${PROJECT_DIR}" ] && [ "$(ls -A ${PROJECT_DIR} 2>/dev/null)" ]; then
    cp -r ${PROJECT_DIR}/* $BACKUP_PATH/
    ln -sfn $BACKUP_PATH ${BACKUP_DIR}/latest
    echo "✅ Backup created: $BACKUP_PATH"

    cd ${BACKUP_DIR}
    ls -dt */ | grep -v latest | tail -n +3 | xargs rm -rf || true
fi
'''
            }
        }

        // ✅ Checkout
        stage('Checkout Code') {
            steps {
                sh '[ -d "${PROJECT_DIR}" ] || mkdir -p ${PROJECT_DIR}'

                dir("${PROJECT_DIR}") {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[url: "${REPO_URL}"]]
                    ])
                }
            }
        }

        // ✅ Validate
        stage('Validate Backend') {
            steps {
                sh '''
#!/bin/bash
set -e
[ -f "${BACKEND_DIR}/server.js" ] || exit 1
[ -f "${BACKEND_DIR}/package.json" ] || exit 1
'''
            }
        }

        // ✅ Install
        stage('Install Dependencies') {
            steps {
                sh '''
cd ${BACKEND_DIR}
npm install
'''
            }
        }

        // ✅ Deploy
        stage('Deploy with PM2') {
            steps {
                sh '''
cd ${BACKEND_DIR}

command -v pm2 >/dev/null || sudo npm install -g pm2

pm2 delete ${APP_NAME} || true
pm2 start server.js --name ${APP_NAME}
pm2 save

sleep 5
'''
            }
        }

        // ✅ Nginx
        stage('Configure Nginx') {
            steps {
                sh '''
sudo nginx -t
sudo systemctl restart nginx
'''
            }
        }

        // ✅ FULL E2E CHECK
        stage('End-to-End Health Check') {
            steps {
                sh '''
#!/bin/bash
set -e

echo "🔍 Running E2E checks..."

pm2 list | grep ${APP_NAME} || exit 1

ss -tuln | grep 3000 || {
    echo "❌ Port 3000 not listening"
    exit 1
}

curl -f http://localhost:3000/health || exit 1
curl -f http://localhost:3000/api || exit 1
curl -s http://localhost:3000 | grep "html" || exit 1
curl -f http://localhost || exit 1

echo "✅ App Healthy"
'''
            }
        }
    }

    post {

        failure {
            echo "❌ Deployment Failed → Rolling Back"

            script {
                sh '''
#!/bin/bash
set -e

LAST_BACKUP=${BACKUP_DIR}/latest

if [ ! -d "$LAST_BACKUP" ]; then
    echo "⚠️ No backup found"
    exit 0
fi

rm -rf ${PROJECT_DIR}/*
cp -r $LAST_BACKUP/* ${PROJECT_DIR}/

cd ${BACKEND_DIR}
npm install

pm2 delete ${APP_NAME} || true
pm2 start server.js --name ${APP_NAME}

sleep 5

echo "🔁 Verifying rollback..."

if curl -f http://localhost:3000/health; then
    echo "✅ Rollback success"
else
    echo "❌ Rollback failed"
fi
'''
            }

            // ✅ Mark build SUCCESS after rollback
            script {
                currentBuild.result = 'SUCCESS'
            }
        }

        success {
            echo "✅ Deployment successful"
        }

        always {
            echo "📋 Pipeline finished"
        }
    }
}
