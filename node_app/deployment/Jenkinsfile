pipeline {
    agent any

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
    }

    stages {

        stage('Setup Permissions') {
            steps {
                script {
                    echo "🔐 Setting up directories..."
                    sh '''
                        sudo mkdir -p /opt/projects
                        sudo chown -R jenkins:jenkins /opt/projects
                    '''
                }
            }
        }

        stage('Checkout Code') {
            steps {
                script {
                    echo "📥 Cloning repository..."
                    sh '''
                        mkdir -p ${PROJECT_DIR}
                    '''
                    dir("${PROJECT_DIR}") {
                        git branch: 'main', url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    echo "📦 Installing dependencies..."
                    sh '''
                        cd ${PROJECT_DIR}/backend
                        npm install
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                script {
                    echo "🏗️ Building application..."
                    sh '''
                        cd ${PROJECT_DIR}/backend
                        npm run build || echo "⚠️ No build step"
                    '''
                }
            }
        }

        stage('Deploy with PM2 (Ubuntu User)') {
            steps {
                script {
                    echo "🚀 Deploying app..."

                    sh '''
                        cd ${PROJECT_DIR}/backend

                        # Install PM2 if not exists
                        if ! command -v pm2 > /dev/null; then
                            sudo npm install -g pm2
                        fi

                        # ✅ Clean restart (fix)
                        sudo -u ubuntu pm2 delete webapp || true
                        sudo -u ubuntu pm2 start server.js --name webapp
                        sudo -u ubuntu pm2 save

                        # Debug
                        sudo -u ubuntu pm2 list
                        sleep 5
                    '''
                }
            }
        }

        stage('Configure Nginx') {
            steps {
                script {
                    echo "🌐 Configuring Nginx..."
                    sh '''
                        sudo bash -c 'cat > /etc/nginx/sites-available/default <<EOF
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \\$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \\$host;
        proxy_cache_bypass \\$http_upgrade;
    }
}
EOF'

                        sudo nginx -t
                        sudo systemctl restart nginx
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "🩺 Running health check..."
                    sh '''
                        sleep 5
                        curl -f http://localhost:3000/health

                        echo "📊 Port check:"
                        netstat -tulnp | grep 3000 || echo "⚠️ Port not running"

                        echo "📜 PM2 Logs:"
                        sudo -u ubuntu pm2 logs webapp --lines 20
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }

        failure {
            echo "❌ Deployment failed. Check logs."
        }

        always {
            echo "📋 Pipeline finished."
        }
    }
}
