pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        BASE_DIR     = "/opt/projects"
        PROJECT_NAME = "webapplication-repo"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
        RUN_FRONTEND = "false"
    }

    stages {

        // ✅ Checkout pipeline repo (Jenkinsfile repo)
        stage('Checkout Pipeline Repo') {
            steps {
                checkout scm
            }
        }

        // ✅ Checkout actual application repo
        stage('Checkout App Repo') {
            steps {
                dir('app') {
                    git branch: 'main', url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        // ✅ Detect changes in APP repo (IMPORTANT FIX)
        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(
                        script: "cd app && git diff --name-only HEAD~1 HEAD || true",
                        returnStdout: true
                    ).trim()

                    echo "Changed files in app repo: ${changes}"

                    if (changes.contains("frontend/")) {
                        env.RUN_FRONTEND = "true"
                        echo "✅ Frontend changes detected"
                    } else {
                        echo "❌ No frontend changes"
                    }
                }
            }
        }

        // ✅ Setup permissions
        stage('Setup Permissions') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sudo mkdir -p /opt/projects
                    sudo chown -R jenkins:jenkins /opt/projects
                '''
            }
        }

        // ✅ Copy app code
        stage('Copy Code') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    rm -rf ${PROJECT_DIR}
                    mkdir -p ${PROJECT_DIR}
                    cp -r app/* ${PROJECT_DIR}/
                '''
            }
        }

        // ✅ Install dependencies
        stage('Install Dependencies') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm install
                '''
            }
        }

        // ✅ Build app
        stage('Build Application') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm run build || echo "No build step"
                '''
            }
        }

        // ✅ Deploy with PM2
        stage('Deploy with PM2') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend

                    if ! command -v pm2 > /dev/null; then
                        sudo npm install -g pm2
                    fi

                    sudo -u ubuntu pm2 restart webapp || sudo -u ubuntu pm2 start server.js --name webapp
                    sudo -u ubuntu pm2 save
                '''
            }
        }

        // ✅ Restart Nginx
        stage('Configure Nginx') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sudo systemctl restart nginx
                '''
            }
        }

        // ✅ Health check
        stage('Health Check') {
            when {
                expression { env.RUN_FRONTEND == "true" }
            }
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:3000/health
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
