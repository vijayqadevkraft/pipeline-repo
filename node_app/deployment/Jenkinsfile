pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        PROJECT_NAME = "webapplication-repo"
        BASE_DIR     = "/opt/projects"
        PROJECT_DIR  = "${BASE_DIR}/${PROJECT_NAME}"
    }

    stages {

        stage('Run Only for Frontend Changes') {
            when {
                changeset "frontend/**"
            }
            steps {
                echo "✅ Frontend changed → Running pipeline"
            }
        }

        stage('Setup Permissions') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    sudo mkdir -p /opt/projects
                    sudo chown -R jenkins:jenkins /opt/projects
                '''
            }
        }

        stage('Checkout Code') {
            when {
                changeset "frontend/**"
            }
            steps {
                dir("${PROJECT_DIR}") {
                    git branch: 'main', url: 'https://github.com/vijayqadevkraft/webapplication-repo.git'
                }
            }
        }

        stage('Install Dependencies') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm install
                '''
            }
        }

        stage('Build Application') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend
                    npm run build || echo "No build step"
                '''
            }
        }

        stage('Deploy with PM2') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    cd ${PROJECT_DIR}/backend

                    if ! command -v pm2 > /dev/null; then
                        sudo npm install -g pm2
                    fi

                    sudo -u ubuntu pm2 restart webapp || sudo -u ubuntu pm2 start server.js --name webapp
                    sudo -u ubuntu pm2 save
                '''
            }
        }

        stage('Configure Nginx') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    sudo systemctl restart nginx
                '''
            }
        }

        stage('Health Check') {
            when {
                changeset "frontend/**"
            }
            steps {
                sh '''
                    sleep 5
                    curl -f http://localhost:3000/health
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully!"
        }
        failure {
            echo "❌ Deployment failed."
        }
        always {
            echo "📋 Pipeline finished."
        }
    }
}
